! Camp Fire EKI calibration: one fire per run, uniform weather (the JG+CO mean,
! corrected per run). Same model settings as ../local_sensitivity/elmfire.data.template,
! which has the same changes from ~/elmfire-class/camp_fire/elmfire.data.in as the
! Sobol experiment:
!   INPUTS        fuels and misc from the shared copy; IGNITIONS_CSV_FILENAME
!                 (fixed ignition) replaces IGNITION_MASK_FILENAME; weather from
!                 this run's uniform rasters (m1/m10/m100 replace m1f/m10f/m100f)
!   OUTPUTS       no ember flux or flame length
!   TIME_CONTROL  SIMULATION_TSTART and SIMULATION_TSTOP from config (ignition
!                 at 06:15 PST, stop 24 h after t0)
!   SIMULATOR     WIND_FLUCTUATIONS and RANDOMIZE_RANDOM_SEED off
!   MONTE_CARLO   one fire at a fixed location, one starting band, fixed SEED;
!                 the WS, WD, M1, M10, M100 offsets removed (the study sets
!                 the weather), ADJ and WAF offsets kept as fixed values
!   SPOTTING      on, at the baseline case's settings; P_EPS = 0.01 exp(p), from the run's coefficient p (v3)
!   MISCELLANEOUS shared misc folder; SCRATCH in node-local storage
! Fields in braces are filled in by eki.case. Do not put ampersands or
! braces in these comments.
&INPUTS
FUELS_AND_TOPOGRAPHY_DIRECTORY = '{fuels_dir}'
ASP_FILENAME = 'asp'
CBD_FILENAME = 'cbd'
CBH_FILENAME = 'cbh'
CC_FILENAME = 'cc'
CH_FILENAME = 'ch'
DEM_FILENAME = 'dem'
FBFM_FILENAME = 'fbfm40b'
SLP_FILENAME = 'slp'
ADJ_FILENAME = 'adj'
PHI_FILENAME = 'phi'
IGNITIONS_CSV_FILENAME = 'ignition.csv'
BLDG_AREA_FILENAME = 'baa_m'
BLDG_FOOTPRINT_FRAC_FILENAME = 'ff'
BLDG_FUEL_MODEL_FILENAME = 'bfm13'
BLDG_NONBURNABLE_FRAC_FILENAME = 'nbf'
BLDG_SEPARATION_DIST_FILENAME = 'ssd_min'
WEATHER_DIRECTORY = '{weather_dir}'
DT_METEOROLOGY = {dt_weather_s}
WS_FILENAME = 'ws'
WD_FILENAME = 'wd'
M1_FILENAME = 'm1'
M10_FILENAME = 'm10'
M100_FILENAME = 'm100'
DEAD_MC_IN_PERCENT = .TRUE.
LIVE_MC_IN_PERCENT = .TRUE.
USE_CONSTANT_LH = .TRUE.
LH_MOISTURE_CONTENT = 30.0
USE_CONSTANT_LW = .TRUE.
LW_MOISTURE_CONTENT = 60.0
USE_CONSTANT_FMC = .TRUE.
FOLIAR_MOISTURE_CONTENT = 90.0
/

&OUTPUTS
OUTPUTS_DIRECTORY = './outputs'
CONVERT_TO_GEOTIFF = .TRUE.
DTDUMP = 3600.0
DUMP_FIRE_SIZE_STATS = .TRUE.
DUMP_EMBER_FLUX = .FALSE.
DUMP_FLAME_LENGTH = .FALSE.
DUMP_TIME_OF_ARRIVAL = .TRUE.
/

&TIME_CONTROL
SIMULATION_TSTART = {ignition_s}
SIMULATION_TSTOP = {stop_s}
SIMULATION_DT = 1.0
SIMULATION_DTMAX = 15.0
TARGET_CFL = 0.45
/

&SIMULATOR
CROWN_FIRE_MODEL = 2
MODE = 1
ALLOW_NONBURNABLE_PIXEL_IGNITION = .FALSE.
MAX_RUNTIME = 30000000.0
MULTIPLE_HOSTS = .TRUE.
BANDTHICKNESS = 3
WIND_FLUCTUATIONS = .FALSE.
DT_WIND_FLUCTUATIONS = 30.0
WIND_DIRECTION_FLUCTUATION_INTENSITY = 0.15
WIND_SPEED_FLUCTUATION_INTENSITY = 0.1
RANDOMIZE_RANDOM_SEED = .FALSE.
UNTAG_CELLS_TIMESTEP_INTERVAL = 10
UNTAG_TYPE_2 = .TRUE.
UNTAG_TYPE_3 = .TRUE.
/

&MONTE_CARLO
METEOROLOGY_BAND_START = 1
METEOROLOGY_BAND_STOP = 1
METEOROLOGY_BAND_SKIP_INTERVAL = 1
NUM_METEOROLOGY_TIMES = {nbands}
ALLOW_MULTIPLE_IGNITIONS_AT_A_PIXEL = .TRUE.
EDGEBUFFER = 30.0
NUM_ENSEMBLE_MEMBERS = 1
RANDOM_IGNITIONS = .TRUE.
CSV_FIXED_IGNITION_LOCATIONS = .TRUE.
USE_IGNITION_MASK = .FALSE.
SEED = {seed}
WIND_DIRECTION_FLUCTUATION_INTENSITY_MIN = 0.15
WIND_DIRECTION_FLUCTUATION_INTENSITY_MAX = 0.15
WIND_SPEED_FLUCTUATION_INTENSITY_MIN = 0.1
WIND_SPEED_FLUCTUATION_INTENSITY_MAX = 0.1
NUM_RASTERS_TO_PERTURB = 2
RASTER_TO_PERTURB(1) = 'ADJ'
SPATIAL_PERTURBATION(1) = 'GLOBAL'
TEMPORAL_PERTURBATION(1) = 'STATIC'
PDF_TYPE(1) = 'UNIFORM'
PDF_LOWER_LIMIT(1) = 0.2839
PDF_UPPER_LIMIT(1) = 0.2839
RASTER_TO_PERTURB(2) = 'WAF'
SPATIAL_PERTURBATION(2) = 'GLOBAL'
TEMPORAL_PERTURBATION(2) = 'STATIC'
PDF_TYPE(2) = 'UNIFORM'
PDF_LOWER_LIMIT(2) = -0.0197
PDF_UPPER_LIMIT(2) = -0.0197
/

&SPOTTING
ENABLE_SPOTTING = .TRUE.
ENABLE_SURFACE_FIRE_SPOTTING = .TRUE.
USE_SUPERSEDED_SPOTTING = .FALSE.
GENERATION_MODEL = 'PER-MW'
SPOTTING_DISTANCE_MODEL = 'EMPIRICAL'
ACCUMULATION_MODEL = 'EULERIAN'
IGNITION_MODEL = 'PHYSICAL'
USE_PHYSICAL_SPOTTING_DURATION = .FALSE.
EMBER_GR_PER_MW_BLDG = 20.0
EMBER_GR_PER_MW_VEGE = 33.3
CRITICAL_SPOTTING_FIRELINE_INTENSITY(:) = 0.0
SURFACE_FIRE_SPOTTING_PERCENT_MULT(91) = 1.0
SURFACE_FIRE_SPOTTING_PERCENT_MULT(102) = 1.0
SURFACE_FIRE_SPOTTING_PERCENT_MULT(103) = 1.0
GLOBAL_SURFACE_FIRE_SPOTTING_PERCENT_MAX = 100.0
GLOBAL_SURFACE_FIRE_SPOTTING_PERCENT_MIN = 100.0
P_EPS = 0.01
DIFF_WILDLAND_IGNITION = .TRUE.
USE_CROSSWIND_DISTRIBUTION = .FALSE.
USE_EMBER_CONSUMPTION = .FALSE.
LOCAL_IGNITION_TIME = 0.0
CELL_IGNITION_DELAY = 1000.0
NO_SURFACE_FIRE = .FALSE.
/

&WUI
BLDG_SPREAD_MODEL_TYPE = 1
USE_BLDG_SPREAD_MODEL = .TRUE.
USE_CONSTANT_BLDG_SPREAD_MODEL_PARAMS = .FALSE.
/

&MISCELLANEOUS
MISCELLANEOUS_INPUTS_DIRECTORY = '{misc_dir}'
FUEL_MODEL_FILE = 'fuel_models.csv'
BUILDING_FUEL_MODEL_FILE = 'building_fuel_models.csv'
PATH_TO_GDAL = 'auto'
SCRATCH = '{scratch_dir}'
/
